generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Guild {
  id                 String   @id // Discord Guild ID
  prefix             String   @default("!")
  language           String   @default("fr") // fr | en
  logChannelId       String?
  welcomeEnabled     Boolean  @default(true)
  welcomeChannelId   String?
  welcomeMessage     String?  @default("Bienvenue {user} sur {server} ! Nous sommes désormais {membercount} membres.")
  welcomeBgUrl       String?
  leaveEnabled       Boolean  @default(true)
  leaveChannelId     String?
  leaveMessage       String?  @default("{user} a quitté {server}. Nous sommes désormais {membercount} membres.")
  leaveBgUrl         String?
  autoRoleId         String?
  currencyName       String   @default("Flow")
  warnThresholdMute  Int      @default(3)
  warnThresholdBan   Int      @default(5)
  antiRaidEnabled    Boolean  @default(false)
  antiSpamEnabled    Boolean  @default(false)
  ticketCategoryId   String?
  ticketLogsChannelId String?
  ticketStaffRoleId  String?
  ticketLimit        Int      @default(1)
  timeCapsuleChannelId String?
  ownerUserId        String?
  isLocked           Boolean  @default(false)
  levelingEnabled    Boolean  @default(true)
  excludedXpChannelIds String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  members            Member[]
  warnings           Warning[]
  giveaways          Giveaway[]
  transactions       Transaction[]
  shopItems          ShopItem[]
  tickets            Ticket[]
  moderationCases    ModerationCase[]
  timeCapsules       TimeCapsule[]
  forgeVisibility    String   @default("discovered") // "discovered" | "all"
  forgeRecipes       ForgeRecipe[]
  forgeLogs          ForgeLog[]
  auraEnabled            Boolean       @default(true)
  auraDailyLimit         Int           @default(5)
  auraPairCooldownHours  Int           @default(24)
  endorsements           Endorsement[]
  auraQualities          AuraQuality[]
  auraTiers              AuraTier[]
  staffHistory           StaffHistory[]
  legacySettings         LegacySettings?
  activitySnapshots      ActivitySnapshot[]
  pulseAlertSettings     PulseAlertSettings?

  @@index([ownerUserId, isLocked])
  @@map("guilds")
}

model Member {
  id          String   @id @default(uuid())
  guildId     String
  userId      String
  balance     Int      @default(100)
  bankBalance Int      @default(0)
  xp          Int      @default(0)
  dailyStreak Int      @default(0)
  lastDaily   DateTime?
  lastWork    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  inventory   InventoryItem[]
  warnings    Warning[]
  transactions Transaction[]
  giveawayEntries GiveawayEntry[]

  @@unique([guildId, userId])
  @@map("members")
}

model Warning {
  id          String   @id @default(uuid())
  guildId     String
  userId      String
  moderatorId String
  reason      String
  createdAt   DateTime @default(now())

  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  member      Member   @relation(fields: [guildId, userId], references: [guildId, userId], onDelete: Cascade)

  @@map("warnings")
}

model Giveaway {
  id             String   @id @default(uuid())
  messageId      String?  @unique
  guildId        String
  channelId      String
  hostId         String
  prize          String
  winnersCount   Int      @default(1)
  requiredRoleId String?
  endsAt         DateTime
  ended          Boolean  @default(false)
  winners        String[] @default([])
  createdAt      DateTime @default(now())

  guild          Guild           @relation(fields: [guildId], references: [id], onDelete: Cascade)
  entries        GiveawayEntry[]

  @@map("giveaways")
}

model GiveawayEntry {
  id         String   @id @default(uuid())
  giveawayId String
  guildId    String
  userId     String
  createdAt  DateTime @default(now())

  giveaway   Giveaway @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  member     Member   @relation(fields: [guildId, userId], references: [guildId, userId], onDelete: Cascade)

  @@unique([giveawayId, userId])
  @@map("giveaway_entries")
}

model Transaction {
  id          String   @id @default(uuid())
  guildId     String
  userId      String
  type        String   // DAILY | WORK | PAY | DEPOSIT | WITHDRAW | SHOP_BUY | GAME_WIN | GAME_LOSS
  amount      Int
  description String
  createdAt   DateTime @default(now())

  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  member      Member   @relation(fields: [guildId, userId], references: [guildId, userId], onDelete: Cascade)

  @@map("transactions")
}

model ShopItem {
  id          String   @id @default(uuid())
  guildId     String
  name        String
  description String
  price       Int
  roleId      String?
  createdAt   DateTime @default(now())

  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  inventories InventoryItem[]
  asForgeResult ForgeRecipe[] @relation("ForgeRecipeResult")
  asForgeIngredient ForgeIngredient[] @relation("ForgeIngredientItem")

  @@map("shop_items")
}

model InventoryItem {
  id         String   @id @default(uuid())
  memberId   String
  shopItemId String
  purchasedAt DateTime @default(now())

  member     Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  shopItem   ShopItem @relation(fields: [shopItemId], references: [id], onDelete: Cascade)

  @@map("inventory_items")
}

model TriviaQuestion {
  id        String   @id @default(uuid())
  category  String   @default("General")
  question  String
  options   String[]
  answer    String
  reward    Int      @default(50)
  createdAt DateTime @default(now())

  @@map("trivia_questions")
}

model TrackedBot {
  id             String        @id @default(cuid())
  guildId        String
  botId          String
  alertChannelId String?
  addedBy        String
  createdAt      DateTime      @default(now())
  events         UptimeEvent[]

  @@unique([guildId, botId])
  @@map("tracked_bots")
}

model UptimeEvent {
  id           String     @id @default(cuid())
  trackedBotId String
  trackedBot   TrackedBot @relation(fields: [trackedBotId], references: [id], onDelete: Cascade)
  status       String     // online | idle | dnd | offline | invisible | not_found
  timestamp    DateTime   @default(now())

  @@index([trackedBotId, timestamp])
  @@map("uptime_events")
}

model Ticket {
  id              String    @id @default(cuid())
  guildId         String
  channelId       String    @unique
  ownerId         String
  type            String    @default("General")
  status          String    @default("open") // open | closed
  claimedBy       String?
  firstResponseAt DateTime?
  createdAt       DateTime  @default(now())
  closedAt        DateTime?
  closedBy        String?
  closeReason     String?

  guild           Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, ownerId, status])
  @@map("tickets")
}

model ModerationCase {
  id          String   @id @default(cuid())
  guildId     String
  targetId    String
  moderatorId String
  type        String   // WARN | MUTE | UNMUTE | KICK | BAN | UNBAN | SOFTBAN | SLOWMODE | NICKNAME | PURGE_USER
  reason      String   @default("Aucune raison spécifiée")
  createdAt   DateTime @default(now())

  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, targetId])
  @@map("moderation_cases")
}

model HangmanWord {
  id        String   @id @default(uuid())
  word      String
  category  String   @default("Général")
  hint      String?
  createdAt DateTime @default(now())

  @@map("hangman_words")
}

model Blacklist {
  id        String   @id @default(cuid())
  type      String   // user | guild
  targetId  String   @unique // userId or guildId
  reason    String   @default("Aucune raison spécifiée")
  addedAt   DateTime @default(now())

  @@map("blacklists")
}

model PremiumWhitelist {
  id        String    @id @default(cuid())
  userId    String    @unique
  maxGuilds Int       @default(1) // -1 for unlimited
  addedBy   String
  reason    String?
  createdAt DateTime  @default(now())
  expiresAt DateTime?

  @@map("premium_whitelists")
}

model MemberXP {
  id            String    @id @default(cuid())
  guildId       String
  userId        String
  xp            Int       @default(0)
  level         Int       @default(0)
  lastMessageAt DateTime? @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([guildId, userId])
  @@index([guildId, xp(sort: Desc)])
  @@map("member_xp")
}

model LevelRole {
  id        String   @id @default(cuid())
  guildId   String
  level     Int
  roleId    String
  createdAt DateTime @default(now())

  @@unique([guildId, level])
  @@map("level_roles")
}

model MusicSettings {
  id              String   @id @default(cuid())
  guildId         String   @unique
  djRoleId        String?
  alwaysOnEnabled Boolean  @default(false)
  defaultVolume   Int      @default(80)
  maxQueueSize    Int      @default(200)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("music_settings")
}

model Playlist {
  id        String   @id @default(cuid())
  userId    String
  guildId   String
  name      String
  // JSON Array<{ encoded: string, title: string, author: string, uri: string, duration: number }>
  tracks    Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, guildId, name])
  @@index([userId, guildId])
  @@map("playlists")
}

model NewsSubscription {
  id               String   @id @default(cuid())
  guildId          String
  channelId        String
  feedUrl          String
  lastPostedItemId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([guildId, channelId, feedUrl])
  @@index([guildId, channelId])
  @@map("news_subscriptions")
}

model VerifySettings {
  guildId          String   @id
  verifyChannelId  String
  verifiedRoleId   String
  unverifiedRoleId String
  enabled          Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("verify_settings")
}

model TempVoiceSettings {
  guildId          String   @id
  triggerChannelId String
  categoryId       String
  nameTemplate     String   @default("🔊 Salon de {user}")
  maxChannels      Int      @default(50)
  enabled          Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("temp_voice_settings")
}

model TempVoiceChannel {
  id        String   @id @default(cuid())
  guildId   String
  channelId String   @unique
  ownerId   String
  createdAt DateTime @default(now())

  @@index([guildId, ownerId])
  @@map("temp_voice_channels")
}

model InviteJoin {
  id          String   @id @default(cuid())
  guildId     String
  memberId    String
  inviterId   String?
  inviteCode  String?
  joinType    String   @default("normal") // normal | vanity | widget | unknown
  leftEarly   Boolean  @default(false)
  joinedAt    DateTime @default(now())

  @@index([guildId, memberId])
  @@index([guildId, inviterId])
  @@map("invite_joins")
}

model InviteBonus {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  amount    Int      @default(0)
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, userId])
  @@map("invite_bonuses")
}

model StreamSubscription {
  id             String   @id @default(cuid())
  guildId        String
  channelId      String
  platform       String   // "twitch" | "youtube"
  targetHandle   String
  targetId       String?
  customMessage  String?
  lastNotifiedId String?
  createdAt      DateTime @default(now())

  @@index([platform, targetHandle])
  @@map("stream_subscriptions")
}

model Birthday {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  day       Int
  month     Int
  year      Int?
  createdAt DateTime @default(now())

  @@unique([guildId, userId])
  @@index([guildId, month, day])
  @@map("birthdays")
}

model BirthdayConfig {
  id        String   @id @default(cuid())
  guildId   String   @unique
  channelId String?
  roleId    String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("birthday_configs")
}

model CountingGame {
  id            String   @id @default(cuid())
  guildId       String   @unique
  channelId     String   @unique
  currentCount  Int      @default(0)
  lastUserId    String?
  highestRecord Int      @default(0)
  enabled       Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  @@map("counting_games")
}

model Confession {
  id        String   @id @default(cuid())
  guildId   String
  number    Int
  authorId  String
  content   String
  messageId String?
  createdAt DateTime @default(now())

  @@unique([guildId, number])
  @@index([guildId, messageId])
  @@map("confessions")
}

model ConfessionConfig {
  id        String   @id @default(cuid())
  guildId   String   @unique
  channelId String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("confession_configs")
}

model ApplicationForm {
  id              String   @id @default(cuid())
  guildId         String
  position        String   // Ex: "Modérateur", "Partenariat"
  questions       Json     // Array of { id, label, style, required }
  reviewChannelId String
  createdAt       DateTime @default(now())

  @@unique([guildId, position])
  @@map("application_forms")
}

model Application {
  id          String   @id @default(cuid())
  guildId     String
  position    String
  applicantId String
  answers     Json     // Record<questionLabel, answerText>
  status      String   @default("pending") // "pending" | "accepted" | "rejected" | "interview"
  reviewedBy  String?
  messageId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([guildId, applicantId])
  @@index([guildId, status])
  @@map("applications")
}

model EmbedTemplate {
  id        String   @id @default(cuid())
  guildId   String
  name      String
  embedData Json     // Title, description, color, fields, etc.
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guildId, name])
  @@map("embed_templates")
}

model Report {
  id         String   @id @default(cuid())
  guildId    String
  reportedId String
  reporterId String
  reason     String
  proofUrl   String?
  status     String   @default("pending") // "pending" | "warned" | "muted" | "ignored"
  messageId  String?
  createdAt  DateTime @default(now())

  @@index([guildId, reportedId])
  @@map("reports")
}

model ReportConfig {
  id        String   @id @default(cuid())
  guildId   String   @unique
  channelId String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("report_configs")
}

model TimeCapsule {
  id                 String    @id @default(cuid())
  guildId            String
  authorId           String
  authorTag          String    // pseudo au moment de la création, pour affichage si le membre part
  content            String
  isPublic           Boolean   @default(true)
  triggerType        String    // "date" | "member_count"
  triggerDate        DateTime?
  triggerMemberCount Int?
  opened             Boolean   @default(false)
  openedAt           DateTime?
  createdAt          DateTime  @default(now())

  guild              Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, opened])
  @@map("time_capsules")
}

model ForgeRecipe {
  id            String            @id @default(cuid())
  guildId       String
  name          String
  resultItemId  String
  successRate   Int               @default(100)
  lossType      String            @default("total") // "total" | "partial"
  createdBy     String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  guild         Guild             @relation(fields: [guildId], references: [id], onDelete: Cascade)
  resultItem    ShopItem          @relation("ForgeRecipeResult", fields: [resultItemId], references: [id], onDelete: Cascade)
  ingredients   ForgeIngredient[]
  logs          ForgeLog[]

  @@unique([guildId, name])
  @@index([guildId])
  @@map("forge_recipes")
}

model ForgeIngredient {
  id         String      @id @default(cuid())
  recipeId   String
  itemId     String
  quantity   Int         @default(1)

  recipe     ForgeRecipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  shopItem   ShopItem    @relation("ForgeIngredientItem", fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([recipeId, itemId])
  @@map("forge_ingredients")
}

model ForgeLog {
  id         String       @id @default(cuid())
  guildId    String
  userId     String
  recipeId   String?
  success    Boolean
  createdAt  DateTime     @default(now())

  guild      Guild        @relation(fields: [guildId], references: [id], onDelete: Cascade)
  recipe     ForgeRecipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@index([guildId, userId])
  @@index([guildId, recipeId])
  @@map("forge_logs")
}

model Endorsement {
  id          String   @id @default(cuid())
  guildId     String
  fromUserId  String
  toUserId    String
  quality     String
  createdAt   DateTime @default(now())

  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, toUserId])
  @@index([guildId, fromUserId, toUserId])
  @@map("endorsements")
}

model AuraQuality {
  id      String @id @default(cuid())
  guildId String
  name    String

  guild   Guild  @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, name])
  @@map("aura_qualities")
}

model AuraTier {
  id        String   @id @default(cuid())
  guildId   String
  name      String
  minScore  Int
  colorHex  String   @default("#3B82F6")
  roleId    String?

  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, minScore])
  @@unique([guildId, name])
  @@map("aura_tiers")
}

model StaffHistory {
  id        String    @id @default(cuid())
  guildId   String
  userId    String
  roleName  String
  grantedAt DateTime  @default(now())
  revokedAt DateTime?

  guild     Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, userId])
  @@map("staff_history")
}

model LegacySettings {
  guildId          String   @id
  channelId        String?
  minTenureDays    Int      @default(90)
  minLevel         Int?     @default(10)
  minInvites       Int?     @default(5)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  guild            Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@map("legacy_settings")
}

model ActivitySnapshot {
  id            String   @id @default(cuid())
  guildId       String
  hourBucket    DateTime // heure arrondie à l'heure
  messageCount  Int
  activeMembers Int
  topChannelId  String?

  guild         Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, hourBucket])
  @@map("activity_snapshots")
}

model PulseAlertSettings {
  guildId       String  @id
  channelId     String?
  lowThreshold  Int?
  highThreshold Int?

  guild         Guild   @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@map("pulse_alert_settings")
}
